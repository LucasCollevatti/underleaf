{
  "name": "@overleaf/web",
  "description": "The HTTP front end for Underleaf",
  "private": true,
  "main": "app.mjs",
  "exports": {
    ".": "./app.mjs",
    "./*": "./*"
  },
  "directories": {
    "public": "./public"
  },
  "scripts": {
    "test:acceptance:debug:run_dir": "mocha --recursive --timeout 25000 --grep=${TEST_NAME_PATTERN:-} --require test/acceptance/bootstrap.js --inspect=0.0.0.0:19999 --inspect-brk",
    "test:unit": "vitest run",
    "test:unit:parallel": "vitest run --project=Parallel",
    "test:unit:sequential": "vitest run --project=Sequential",
    "test:unit:watch": "vitest",
    "test:frontend": "NODE_ENV=test TZ=GMT mocha --recursive --timeout 5000 --exit --extension js,jsx,mjs,ts,tsx --grep=${TEST_NAME_PATTERN:-} --require test/frontend/bootstrap.js --ignore '**/*.spec.{js,jsx,ts,tsx}' --ignore '**/helpers/**/*.{js,jsx,ts,tsx}' test/frontend modules/*/test/frontend",
    "test:frontend:coverage": "c8 --all --include 'frontend/js' --include 'modules/*/frontend/js' --exclude 'frontend/js/vendor' --reporter=lcov --reporter=text-summary yarn run test:frontend",
    "test:writefull": "vitest --run --config modules/writefull/frontend/js/integration/vitest.config.ts",
    "start": "node app.mjs",
    "nodemon": "node --watch app.mjs --watch-locales",
    "webpack": "webpack serve --config webpack.config.js",
    "webpack:production": "webpack --config webpack.config.prod.js",
    "webpack:profile": "webpack --config webpack.config.prod.js --profile --json > stats.json",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix .",
    "lint:styles": "stylelint --cache --cache-location ../../.cache/stylelint/ '**/*.scss'",
    "lint:styles:fix": "stylelint --cache --cache-location ../../.cache/stylelint/ '**/*.scss' --fix",
    "type-check": "tsc --noEmit",
    "type-check:backend": "tsc -p tsconfig.backend.json --noEmit",
    "extract-translations": "i18next-scanner",
    "convert-themes": "node frontend/js/features/source-editor/themes/scripts/convert.js",
    "cypress:open-ct": "OVERLEAF_CONFIG=$(pwd)/config/settings.defaults.js cypress open --component",
    "cypress:run-ct": "OVERLEAF_CONFIG=$(pwd)/config/settings.defaults.js cypress run --component --browser chrome",
    "test:product:e2e": "cypress run --e2e --config-file cypress.underleaf.config.ts --browser chrome",
    "lezer-latex:generate": "node scripts/lezer-latex/generate.mjs",
    "lezer-latex:run": "node scripts/lezer-latex/run.mjs",
    "lezer-latex:benchmark": "node scripts/lezer-latex/benchmark.mjs",
    "lezer-latex:benchmark-incremental": "node scripts/lezer-latex/test-incremental-parser.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "build-unfilled-fonts": "node frontend/fonts/material-symbols/build-unfilled.mjs",
    "precompile-pug": "node app/src/infrastructure/Views.mjs"
  },
  "browserslist": [
    "defaults and supports woff2",
    "last 1 year",
    "safari >= 15"
  ],
