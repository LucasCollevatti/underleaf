extends ./layout-base

include ./_mixins/formMessages
include ./_mixins/bootstrap_js

block entrypointVar
	- entrypoint = 'marketing'

block body
	if typeof suppressNavbar === 'undefined'
		if settings.underleaf
			include underleaf/_navbar
		else
			include layout/navbar-marketing

	block content

	if typeof suppressFooter === 'undefined'
		if settings.underleaf
			include underleaf/_footer
		else if showThinFooter
			include layout/thin-footer
		else
			include layout/fat-footer

	if !settings.underleaf && typeof suppressPugCookieBanner == 'undefined'
		include _cookie_banner

	if !settings.underleaf
		!= moduleIncludes('contactModal-marketing', locals)

block prepend foot-scripts
	+bootstrap-js
