.project-ds-nav-page.website-redesign.underleaf-app-shell.underleaf-static-shell(data-static-theme=initialTheme || 'system')
	.project-list-wrapper.underleaf-app-layout
		include ./_static-sidebar
		.underleaf-app-content
			main#main-content.underleaf-system-main
				section.underleaf-system-panel(aria-labelledby='underleaf-system-heading')
					if systemPage.code
						p.underleaf-system-code= systemPage.code
					h1#underleaf-system-heading= systemPage.title
					if systemPage.descriptionHtml
						div !{systemPage.descriptionHtml}
					else
						p= systemPage.description
					if systemPage.detail
						p.alert.alert-danger= systemPage.detail
					if systemPage.status
						dl.underleaf-system-status
							dt= translate('underleaf_status_web')
							dd= translate(systemPage.status.shuttingDown ? 'underleaf_status_stopping' : 'underleaf_status_ready')
							dt= translate('underleaf_status_site')
							dd= translate(systemPage.status.siteOpen ? 'underleaf_status_ready' : 'underleaf_status_closed')
							dt= translate('underleaf_status_editor')
							dd= translate(systemPage.status.editorOpen ? 'underleaf_status_ready' : 'underleaf_status_closed')
							dt= translate('underleaf_status_uptime')
							dd= systemPage.status.uptimeSeconds
					if systemPage.kind === 'logout'
						form(method='POST' action='/logout')
							input(type='hidden' name='_csrf' value=csrfToken)
							button.btn.btn-primary(type='submit')= translate('log_out')
							a.btn.btn-secondary.ms-2(href='/project')= translate('cancel')
					else
						.underleaf-system-actions
							a.btn.btn-primary(href=systemPage.kind === 'session-expired' ? '/login?session=expired' : systemPage.backPath)= systemPage.kind === 'session-expired' ? translate('log_in') : systemPage.backLabel
							if systemPage.kind === 'status'
								a.btn.btn-secondary(href='/status')= translate('refresh')
			include ./_footer
