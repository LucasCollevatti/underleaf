extends ../layout-react

block entrypointVar
	- entrypoint = 'pages/underleaf-auth'

block vars
	- isWebsiteRedesign = true
	- suppressNavbar = true
	- suppressFooter = true
	- suppressPugCookieBanner = true
	- suppressSkipToContent = false
	- initialTheme = 'dark'

block append meta
	meta(name='ol-underleafAuthPage' content=authPage)
	meta(name='ol-underleafSessionExpired' data-type='boolean' content=!!sessionExpired)

block content
	#underleaf-auth-root
		noscript
			p #{translate('underleaf_auth_requires_js')}
