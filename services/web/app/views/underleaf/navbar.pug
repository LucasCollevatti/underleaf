- const underleafNavUser = getSessionUser()
nav.navbar.navbar-expand-lg.navbar-main.underleaf-navbar(aria-label=translate('primary'))
	.container-fluid
		a.underleaf-navbar-brand(href=underleafNavUser ? '/project' : '/login' aria-label='Underleaf')
			img.underleaf-static-brand-light(src='/underleaf-lockup.svg' alt='Underleaf' width='238' height='48')
			img.underleaf-static-brand-dark(src='/underleaf-lockup-dark.svg' alt='Underleaf' width='238' height='48')
		button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#underleaf-navbar-links' aria-controls='underleaf-navbar-links' aria-expanded='false' aria-label=translate('menu'))
			span.navbar-toggler-icon
		#underleaf-navbar-links.collapse.navbar-collapse.justify-content-end
			.navbar-nav
				if underleafNavUser
					a.nav-link(href='/project')= translate('projects')
					a.nav-link(href='/user/settings')= translate('account_settings')
					if hasAdminAccess()
						a.nav-link(href='/admin')= translate('underleaf_administration')
						a.nav-link(href='/admin/users')= translate('underleaf_users')
						a.nav-link(href='/status')= translate('underleaf_system')
					a.nav-link(href='/logout')= translate('log_out')
				else
					a.nav-link(href='/login')= translate('log_in')
