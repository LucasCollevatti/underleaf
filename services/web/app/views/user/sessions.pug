extends ../layout-react

block entrypointVar
	- entrypoint = 'pages/user/sessions'

block vars
	- isWebsiteRedesign = true
	- suppressNavbar = true
	- suppressFooter = true
	- suppressPugCookieBanner = true
	- suppressSkipToContent = false

block append meta
	meta(name='ol-currentSession' data-type='json' content=currentSession)
	meta(name='ol-sessions' data-type='json' content=sessions)

block content
	#sessions-page-root
