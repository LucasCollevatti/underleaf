# syntax=docker/dockerfile:1-labs

ARG UNDERLEAF_TEXLIVE_IMAGE=texlive/texlive:latest
ARG UNDERLEAF_COMPILER_BASE_IMAGE=underleaf/base:local
FROM ${UNDERLEAF_TEXLIVE_IMAGE} AS official-texlive

FROM ${UNDERLEAF_COMPILER_BASE_IMAGE}

WORKDIR /overleaf

# Use the complete official TeX Live distribution. Package selection belongs
# to the image source, not to a local tlmgr allowlist that can silently omit
# transitive language or style packages.
COPY --from=official-texlive /usr/local/texlive /usr/local/texlive

# Keep latexmk from skipping recompilation when the output PDF is already
# present; SyncTeX must be regenerated for PDF/code navigation.
COPY server-ce/config/latexmkrc /usr/local/share/latexmk/LatexMk

COPY --parents libraries/*/package.json .yarn/patches/ services/*/package.json tools/migrations/ package.json yarn.lock .yarnrc.yml .pnp.register.mjs /overleaf/

ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare yarn@4.18.0 --activate
ENV COREPACK_ENABLE_NETWORK=0

RUN --mount=type=cache,target=/root/.cache \
    --mount=type=cache,target=/root/.yarn/berry/cache,id=compiler-yarn-cache \
    --mount=type=tmpfs,target=/tmp \
    yarn workspaces focus @overleaf/clsi --production

COPY --parents libraries/ services/clsi/ /overleaf/

ENV NODE_OPTIONS="--require /overleaf/.pnp.cjs --import /overleaf/.pnp.register.mjs"
ENV TEXMFVAR=/var/lib/underleaf/compiler/texmf-var
ENV HOME=/tmp

RUN export TEXLIVE_BIN="$(find /usr/local/texlive -type d -path '*/bin/x86_64-linux' -print -quit)" \
  && export PATH="${TEXLIVE_BIN}:${PATH}" \
  && tlmgr path add \
  && command -v pdflatex \
  && command -v xelatex \
  && command -v lualatex \
  && command -v latexmk \
  && command -v bibtex \
  && command -v biber \
  && command -v makeindex \
  && kpsewhich tcolorbox.sty >/dev/null \
  && kpsewhich brazilian.ldf >/dev/null \
  && mkdir -p \
    /var/lib/underleaf/compiler/compiles \
    /var/lib/underleaf/compiler/output \
    /var/lib/underleaf/compiler/cache \
    /var/lib/underleaf/compiler/uploads \
    /var/lib/underleaf/compiler/texmf-var \
  && chown -R www-data:www-data /var/lib/underleaf/compiler

USER www-data
WORKDIR /overleaf/services/clsi

EXPOSE 3013

ENTRYPOINT []
CMD ["node", "app.js"]
