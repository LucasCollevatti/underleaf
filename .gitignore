# -----------------------------------------------------------------------------
# Local configuration and secrets
# -----------------------------------------------------------------------------

.env
.env.*
!.env.example

# Local backup output and staging directories
/backups/
/backup-staging/

# Optional local Compose overrides
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml

# -----------------------------------------------------------------------------
# Yarn Berry / Plug'n'Play
#
# Yarn patches and the optional Yarn-managed tool directories are part of the
# repository when present. The remaining local Yarn state is generated by
# installs and should never be committed.
# -----------------------------------------------------------------------------

.yarn/*
!.yarn/patches/
!.yarn/patches/**
!.yarn/plugins/
!.yarn/plugins/**
!.yarn/releases/
!.yarn/releases/**
!.yarn/sdks/
!.yarn/sdks/**
!.yarn/versions/
!.yarn/versions/**

.pnp.cjs
.pnp.data.json
.pnp.loader.mjs
.pnp.debug.log

# -----------------------------------------------------------------------------
# Dependencies and generated packages
# -----------------------------------------------------------------------------

node_modules/
/dist/
/build/
/out/
/target/

# -----------------------------------------------------------------------------
# Test, coverage, and tool output
# -----------------------------------------------------------------------------

coverage/
.nyc_output/
test-results/
playwright-report/
cypress/screenshots/
cypress/videos/
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Logs, temporary files, and local runtime state
# -----------------------------------------------------------------------------

/*.log
/logs/
/tmp/
/temp/
*.tmp
*.pid
*.seed
*.orig
*.rej
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local database files created by development tools
/*.db
/*.sqlite
/*.sqlite3

# -----------------------------------------------------------------------------
# Operating system and editor files
# -----------------------------------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

.idea/
.vscode/*.log
.vscode/settings.local.json
.vscode/launch.local.json
