# Copy this file to .env before starting Underleaf.
# The platform helpers generate this value with a cryptographically secure RNG.
# Linux: ./scripts/underleaf.sh up. Windows: .\scripts\underleaf.ps1 up.

UNDERLEAF_HTTP_PORT=8080
UNDERLEAF_SITE_URL=http://localhost:8080
UNDERLEAF_SITE_DOMAIN=localhost
UNDERLEAF_PROXY_HTTP_PORT=80
UNDERLEAF_PROXY_HTTPS_PORT=443
UNDERLEAF_BASE_IMAGE=underleaf/base:local
UNDERLEAF_COMPILE_TIMEOUT=3600
UNDERLEAF_COMPILE_CPUS=4
UNDERLEAF_COMPILE_MEMORY=8G
UNDERLEAF_MAX_PROJECT_SIZE=0

UNDERLEAF_SESSION_SECRET=
